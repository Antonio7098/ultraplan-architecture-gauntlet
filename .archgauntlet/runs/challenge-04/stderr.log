{{define "component/operation-result"}}{{with .Result}}
<section class="operation-result" aria-labelledby="operation-result-heading">
  <h2 id="operation-result-heading">Result</h2>
  <p>{{.Message}}</p>
  {{with .Error}}<div class="operation-failure" role="alert"><h3>Why it failed</h3><dl><div><dt>Code</dt><dd><code>{{.Code}}</code></dd></div>{{with index .Details "cause"}}<div><dt>Cause</dt><dd>{{.}}</dd></div>{{end}}{{with index .Details "guidance"}}<div><dt>What to do next</dt><dd>{{.}}</dd></div>{{end}}</dl></div>{{end}}
  {{if .Content}}<div class="code-wrap"><pre>{{.Content}}</pre></div>{{end}}
  {{if .Findings}}<ul class="findings">{{range .Findings}}<li><span class="status status-{{.Severity}}">{{.Severity}}</span><strong>{{.Problem}}</strong>{{if .Cause}}<p>{{.Cause}}</p>{{end}}{{if .Suggestion}}<p>{{.Suggestion}}</p>{{end}}</li>{{end}}</ul>{{end}}
</section>
{{end}}{{end}}

{{define "page/operation"}}{{template "layout/top" .}}{{$csrf := .CSRF}}
<nav aria-label="Breadcrumb"><a href="/">Dashboard</a> / Operation</nav>
{{with .Operation}}
{{$active := or (eq .State "accepted") (eq .State "running") (eq .State "cancelling")}}
<div class="operation-status-page"{{if $active}} data-operation-id="{{.ID}}" data-operation-state="{{.State}}"{{end}}>
  <section class="operation-run-panel" aria-labelledby="run-progress-heading"><header><h2 id="run-progress-heading">Run status</h2><span class="status status-{{if $active}}info{{else if eq .State "succeeded"}}ok{{else}}error{{end}}">{{.State}}</span></header>
  {{if $active}}
  <div id="operation-live" role="status" aria-live="polite">Connecting to the run…</div><ol id="operation-timeline" class="operation-timeline" aria-label="Run progress"></ol><button id="operation-cancel" type="button">Cancel run</button>
  <noscript><p>The run continues on the server when this page is closed. Refresh this page for current status, or use the form below to request cancellation.</p><form method="post" action="/operations/{{.ID}}/cancel"><input type="hidden" name="_csrf" value="{{$csrf}}"><button type="submit">Cancel run</button></form></noscript>
  {{else}}
  {{template "component/operation-result" .}}
  {{end}}
  <p><a class="refresh-link" href="/operations/{{.ID}}">Refresh run status</a>{{if .DurableStatus.Available}} · <a class="refresh-link" href="{{.DurableStatus.RefreshPath}}">Refresh durable status</a>{{end}}</p>
  </section>
</div>
{{end}}
{{template "layout/bottom" .}}{{end}}
