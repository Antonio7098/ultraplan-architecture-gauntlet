		if !req.DryRun {
			_ = SaveFlowState(s.root, sp, NewFlowState(sp, stages, now))
		}
		return FlowResult{Project: sp.Project, Sprint: sp.Slug, To: req.To, DryRun: req.DryRun, Stages: stages}, promptErr
	}
