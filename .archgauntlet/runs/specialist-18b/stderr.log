func TestScratchPromotedFieldsSurviveStorageGate(t *testing.T) {
	ctx := context.Background()
	repo, err := OpenSQLite(ctx, t.TempDir(), SQLiteOptions{})
	if err != nil {
		t.Fatal(err)
	}
	defer repo.Close()
	snap, err := repo.Accept(ctx, Acceptance{Target: Target{Kind: "study", Operation: "analysis"}})
	if err != nil {
		t.Fatal(err)
	}
	owner := Owner{ID: "owner", Process: ProcessIdentity{PID: 1}}
	attempt, _, err := repo.Claim(ctx, Claim{RunID: snap.RunID, Owner: owner, Lease: 15 * time.Second})
	if err != nil {
		t.Fatal(err)
	}
	fence := Fence{RunID: snap.RunID, AttemptID: attempt.ID, OwnerID: owner.ID, FencingGeneration: attempt.FencingGeneration}
	draft := EventDraft{
		Type: EventProgress,
		Payload: map[string]string{
			"runtime_event_id": "evt_1", "runtime_run_id": "run_1", "session_id": "ses_1",
			"type": "message.part.updated", "kind": "text",
			"tool": "write_file", "title": "Editing main.go", "detail": "wrote 40 lines",
			"text": "assistant says hi", "delta": "hi", "content": "body", "action": "edit",
			"state": "done", "status": "ok", "message": "step finished",
			"part_text": "nested promoted", "phase": "execute",
		},
	}
	_, _, err = repo.Append(ctx, fence, draft)
	if err != nil {
		t.Fatal(err)
	}
	events, err := repo.Events(ctx, fence.RunID, 0, 10)
	if err != nil {
		t.Fatal(err)
	}
	t.Logf("stored payload keys:")
	for k, v := range events[0].Payload {
		t.Logf("  %s = %q", k, v)
	}
	if events[0].Omission != nil {
		t.Logf("omission: reason=%q count=%d", events[0].Omission.Reason, events[0].Omission.Count)
	} else {
		t.Logf("omission: none")
	}
}
EOF
