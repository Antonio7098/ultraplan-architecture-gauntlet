	select {
	case <-f.release:
		return app.OperationResult{State: app.OperationComplete, Message: "complete"}, nil
	case <-ctx.Done():
		return app.OperationResult{State: app.OperationCancelled, Message: "cancelled"}, ctx.Err()
	}
}

