			finishErr := manager.FinishOperation(finishCtx, runID, r.State, e)
			cancel()
			if finishErr != nil {
				e = errors.Join(e, finishErr)
			}
		}
		return OperationMsg{Result: r, Err: e, Route: route}
	}
