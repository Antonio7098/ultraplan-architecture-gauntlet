package main

import (
	"database/sql"
	"fmt"
	"os"

	_ "modernc.org/sqlite"
)

func dsn(path string) string {
	return "file:" + path + "?_busy_timeout=5000&_foreign_keys=on&_journal_mode=WAL&_synchronous=FULL&_txlock=immediate"
}

func mustOpen(path string) *sql.DB {
	db, err := sql.Open("sqlite", dsn(path))
	if err != nil {
		panic(err)
	}
	if err := db.Ping(); err != nil {
		panic(err)
	}
	return db
}

func main() {
	switch os.Args[1] {
	case "setup": // phase 1: create, seed, checkpoint, backup; then commit newer and crash WITHOUT close
		os.RemoveAll("/tmp/opencode/waltest/data")
		os.MkdirAll("/tmp/opencode/waltest/data", 0o755)
		db := mustOpen("/tmp/opencode/waltest/data/run.db")
		db.Exec(`CREATE TABLE runs(id INTEGER PRIMARY KEY, name TEXT)`)
		db.Exec(`INSERT INTO runs(name) VALUES ('original')`)
		var busy, logFrames, ckpt int
		if err := db.QueryRow(`PRAGMA wal_checkpoint(TRUNCATE)`).Scan(&busy, &logFrames, &ckpt); err != nil {
			panic(err)
		}
		db.Close()
		// clean close: does the -wal survive?
		if _, err := os.Stat("/tmp/opencode/waltest/data/run.db-wal"); err == nil {
			info, _ := os.Stat("/tmp/opencode/waltest/data/run.db-wal")
			fmt.Printf("AFTER-CLEAN-CLOSE wal size=%d\n", info.Size())
		} else {
			fmt.Println("AFTER-CLEAN-CLOSE wal deleted")
		}
		// operator takes a file-copy backup (consistent: no writers)
		src, _ := os.ReadFile("/tmp/opencode/waltest/data/run.db")
		os.WriteFile("/tmp/opencode/waltest/data/run.db.bak", src, 0o600)
		// new session commits newer data, then CRASHES without Close
		db2 := mustOpen("/tmp/opencode/waltest/data/run.db")
		if _, err := db2.Exec(`INSERT INTO runs(name) VALUES ('newer')`); err != nil {
			panic(err)
		}
		db2.Exec(`PRAGMA wal_checkpoint(PASSIVE)`) // ensure frames hit the -wal file
		os.Exit(1)                                 // simulate SIGKILL: -wal/-shm left on disk
	case "restore-keep-wal": // operator restores db but leaves stale sidecars
		os.Rename("/tmp/opencode/waltest/data/run.db.bak", "/tmp/opencode/waltest/data/run.db")
		for _, suf := range []string{"-wal", "-shm"} {
			if _, err := os.Stat("/tmp/opencode/waltest/data/run.db" + suf); err == nil {
				fmt.Printf("stale %s present\n", suf)
			}
		}
		report()
	case "restore-clean-sidecars": // operator restores db AND deletes stale sidecars
		os.Rename("/tmp/opencode/waltest/data/run.db.bak", "/tmp/opencode/waltest/data/run.db")
		os.Remove("/tmp/opencode/waltest/data/run.db-wal")
		os.Remove("/tmp/opencode/waltest/data/run.db-shm")
		report()
	}
}

func report() {
	db := mustOpen("/tmp/opencode/waltest/data/run.db")
	defer db.Close()
	rows, err := db.Query(`SELECT name FROM runs ORDER BY id`)
	if err != nil {
		fmt.Println("OPEN/QUERY FAILED:", err)
