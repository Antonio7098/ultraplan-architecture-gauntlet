func executeStateCheckpoint(state ExecuteRunState) bool {
	if len(state.Tasks) == 0 {
		return false
	}
	for _, task := range state.Tasks {
		if !isTerminalExecuteStatus(task.Status) {
			return false
		}
	}
	return true
}

