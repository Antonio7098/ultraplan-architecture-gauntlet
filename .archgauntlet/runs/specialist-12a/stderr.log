				fmt.Printf("plain write failed at tick %d: %v\n", i, err)
				return
			}
			time.Sleep(500 * time.Millisecond)
		}
		fmt.Println("plain completed all ticks")
	})
	mux.HandleFunc("/extended", func(w http.ResponseWriter, r *http.Request) {
		http.NewResponseController(w).SetWriteDeadline(time.Now().Add(10 * time.Second))
		w.WriteHeader(http.StatusOK)
