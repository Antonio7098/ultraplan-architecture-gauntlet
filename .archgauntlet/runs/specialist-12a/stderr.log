package main

import (
	"fmt"
	"net/http"
	"time"
)

func stream(w http.ResponseWriter, extend bool) {
	if extend {
		http.NewResponseController(w).SetWriteDeadline(time.Now().Add(10 * time.Second))
	}
	flusher := w.(http.Flusher)
	w.WriteHeader(http.StatusOK)
	flusher.Flush()
	for i := 0; i < 8; i++ {
		time.Sleep(500 * time.Millisecond)
		if _, err := fmt.Fprintf(w, "tick %d\n", i); err != nil {
			fmt.Printf("%s: write failed at tick %d (t≈%.1fs): %v\n", label(extend), i, float64(i+1)*0.5, err)
			return
		}
		flusher.Flush()
	}
	fmt.Printf("%s: completed all 8 ticks (4s)\n", label(extend))
}

func label(extend bool) string { if extend { return "extended" }; return "plain    " }

func main() {
	mux := http.NewServeMux()
	mux.HandleFunc("/plain", func(w http.ResponseWriter, r *http.Request) { stream(w, false) })
	mux.HandleFunc("/extended", func(w http.ResponseWriter, r *http.Request) { stream(w, true) })
	srv := &http.Server{Addr: "127.0.0.1:18322", Handler: mux, WriteTimeout: 2 * time.Second}
	go srv.ListenAndServe()
	time.Sleep(200 * time.Millisecond)

	for _, path := range []string{"/plain", "/extended"} {
		resp, err := http.Get("http://127.0.0.1:18322" + path)
		if err != nil { panic(err) }
		go func() {
			buf := make([]byte, 64)
			for {
				n, err := resp.Body.Read(buf)
				if n > 0 { fmt.Printf("%s client read: %q", path, string(buf[:n])) }
				if err != nil { fmt.Printf("%s client read end: %v\n", path, err); return }
			}
		}()
	}
	time.Sleep(6 * time.Second)
	srv.Close()
}
EOF
