				fmt.Printf("extended write failed at tick %d: %v\n", i, err)
				return
			}
			time.Sleep(500 * time.Millisecond)
		}
		fmt.Println("extended completed all ticks")
	})
	srv := httptest.NewUnstartedServer(mux)
	srv.WriteTimeout = 2 * time.Second // stand-in for ultraplan-go's 30s vs 4s test loop
	srv.Start()
	defer srv.Close()

	resp, err := http.Get(srv.URL + "/plain")
	if err != nil { panic(err) }
	fmt.Println("plain status:", resp.StatusCode)
	time.Sleep(5 * time.Second)

	resp2, err := http.Get(srv.URL + "/extended")
	if err != nil { panic(err) }
	fmt.Println("extended status:", resp2.StatusCode)
	time.Sleep(5 * time.Second)
}
