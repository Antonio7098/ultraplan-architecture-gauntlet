	if project.Ref == "" || len(project.Artifacts) == 0 || strings.Contains(project.Artifacts[0].Ref, "/") {
		t.Fatalf("project/artifacts=%+v", project)
	}
	preview, err := queries.Artifact(context.Background(), project.Artifacts[0].Ref)
