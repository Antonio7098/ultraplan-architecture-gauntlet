	fmt.Fprintf(deps.stdout, "Study progress summary: %s\n", workspace.Rel(root, study.RunHistorySummaryPath(result.Study)))
	fmt.Fprintf(deps.stdout, "Lock: %s\n", workspace.Rel(root, result.LockPath))
