		}
		preview, err := queries.Artifact(context.Background(), artifact.Ref)
		if err != nil || !strings.Contains(preview.Content, "# Sprint Code Context") || preview.Truncated {
			t.Fatalf("code-context preview=%+v err=%v", preview, err)
		}
		return
