func flowStateCheckpoint(state FlowState) bool {
	for _, stage := range state.Stages {
		if stage.Status != StatusComplete && stage.Status != StatusFailed && stage.Status != StatusSkipped {
			return false
		}
	}
	return len(state.Stages) > 0
}

