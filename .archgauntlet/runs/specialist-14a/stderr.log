			buf := make([]byte, 4096)
			for {
				n, err := stdout.Read(buf)
				if n > 0 {
					mu.Lock()
					data += string(buf[:n])
					mu.Unlock()
				}
				if err != nil {
					close(done)
					return
				}
			}
		}()
		waited := make(chan error, 1)
		go func() { waited <- cmd.Wait() }()
		<-waited // Wait returns as soon as the child exits; may close the pipe first
		<-done
		mu.Lock()
		if data != "HELLO-TAIL" {
			lost++
		}
		mu.Unlock()
	}
	fmt.Printf("lost tail %d/4000\n", lost)
}
