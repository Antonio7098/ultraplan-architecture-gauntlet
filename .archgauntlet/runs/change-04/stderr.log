package changeprobe

import (
	"context"
	"database/sql"
	"fmt"
	"os"
	"testing"

	rc "github.com/Antonio7098/ultraplan-go/internal/runcontrol"
)

func openRepo(t *testing.T) (*rc.SQLiteRepository, string) {
	t.Helper()
	root := t.TempDir()
	repo, err := rc.OpenSQLite(context.Background(), root, rc.SQLiteOptions{})
	if err != nil {
		t.Fatalf("open: %v", err)
	}
	t.Cleanup(func() { repo.Close() })
	return repo, root
}

func acceptAndClaim(t *testing.T, repo *rc.SQLiteRepository) rc.Fence {
	t.Helper()
	snap, err := repo.Accept(context.Background(), rc.Acceptance{Target: rc.Target{Kind: "study", Operation: "probe"}})
	if err != nil {
		t.Fatalf("accept: %v", err)
	}
	attempt, _, err := repo.Claim(context.Background(), rc.Claim{RunID: snap.RunID, Owner: rc.Owner{ID: "probe-owner"}, Lease: rc.OwnerLeaseDuration})
	if err != nil {
		t.Fatalf("claim: %v", err)
	}
	return rc.Fence{RunID: snap.RunID, AttemptID: attempt.ID, OwnerID: "probe-owner", FencingGeneration: attempt.FencingGeneration}
}

// Probe 1: a hypothetical new event type accepted by Go but unknown to the v1 CHECK constraint.
func TestNewEventTypeAgainstV1Schema(t *testing.T) {
	repo, root := openRepo(t)
	db, err := sql.Open("sqlite", "file:"+root+"/.ultraplan/run-control.db")
	if err != nil {
		t.Fatal(err)
	}
	defer db.Close()
	snap, err := repo.Accept(context.Background(), rc.Acceptance{Target: rc.Target{Kind: "study", Operation: "vocab"}})
	if err != nil {
		t.Fatal(err)
	}
	attempt, _, err := repo.Claim(context.Background(), rc.Claim{RunID: snap.RunID, Owner: rc.Owner{ID: "o"}, Lease: rc.OwnerLeaseDuration})
	if err != nil {
		t.Fatal(err)
	}
	_, err = db.Exec(`INSERT INTO events (run_id, sequence, committed_at, event_type, payload_json) VALUES (?, 1, ?, 'metrics', '{}')`,
		string(snap.RunID), "2026-08-24T00:00:00Z")
	fmt.Printf("PROBE1 direct insert of new type err=%v\n", err)

	fence := rc.Fence{RunID: snap.RunID, AttemptID: attempt.ID, OwnerID: "o", FencingGeneration: attempt.FencingGeneration}
	_, _, err = repo.Append(context.Background(), fence, rc.EventDraft{Type: rc.EventType("metrics"), Payload: map[string]string{"state": "x"}})
	fmt.Printf("PROBE1 Append via API (IsValid=false path) err=%v isInvalid=%v\n", err, err != nil && rc.IsInvalidArgument(err))
}

// Probe 2: chatty non-whitelisted type wedges per-run compaction.
func TestChattyNonRemovableTypeWedgesRun(t *testing.T) {
	repo, _ := openRepo(t)
	fence := acceptAndClaim(t, repo)
	ctx := context.Background()
	var firstFailure error
	for i := 1; i <= 4200; i++ {
		_, _, err := repo.Append(ctx, fence, rc.EventDraft{Type: rc.EventFinding, Payload: map[string]string{"index": fmt.Sprint(i)}})
		if err != nil {
			firstFailure = err
			fmt.Printf("PROBE2 append #%d failed: %v\n", i, err)
			break
		}
	}
	if firstFailure == nil {
		fmt.Println("PROBE2 no failure after 4200 findings")
	}
	// After the wedge, does any further append (even progress) still fail?
	_, _, err := repo.Append(ctx, fence, rc.EventDraft{Type: rc.EventProgress, Payload: map[string]string{"state": "after-wedge"}})
	fmt.Printf("PROBE2 subsequent progress append err=%v\n", err)
	snap, snapErr := repo.Snapshot(ctx, fence.RunID)
	fmt.Printf("PROBE2 snapshot lifecycle=%s recordState=%s lastSeq=%d err=%v\n", snap.Lifecycle, snap.RecordState, snap.LastSequence, snapErr)
	_ = os.Remove("")
}
