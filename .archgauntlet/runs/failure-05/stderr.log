package main

import (
	"bufio"
	"fmt"
	"net/http"
	"net/http/httptest"
	"time"
)

var start time.Time

func streamHandler(extend bool) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		if extend {
			_ = http.NewResponseController(w).SetWriteDeadline(time.Now().Add(30 * time.Second))
		}
		w.Header().Set("Content-Type", "text/event-stream")
		w.WriteHeader(http.StatusOK)
		flusher := w.(http.Flusher)
		flusher.Flush()
		heartbeat := time.NewTicker(50 * time.Millisecond)
		defer heartbeat.Stop()
		for i := 0; ; i++ {
			select {
			case <-heartbeat.C:
				if _, err := fmt.Fprint(w, ": hb\n\n"); err != nil {
					fmt.Printf("extend=%-5v stream DIED  after %d heartbeats, %v after start: %v\n", extend, i, time.Since(start).Round(time.Millisecond), err)
					return
				}
				flusher.Flush()
			case <-time.After(1200 * time.Millisecond):
				fmt.Printf("extend=%-5v stream SURVIVED full window (%d heartbeats)\n", extend, i)
				return
			}
		}
	}
}

func main() {
	mux := http.NewServeMux()
	mux.HandleFunc("/plain", streamHandler(false))
	mux.HandleFunc("/extended", streamHandler(true))
	server := &http.Server{
		Handler:      mux,
		WriteTimeout: 300 * time.Millisecond, // scaled-down stand-in for web.WriteTimeout = 30s
	}
	ts := httptest.NewUnstartedServer(mux)
	ts.Config = server
	ts.Start()
	defer ts.Close()
	for _, path := range []string{"/plain", "/extended"} {
		resp, err := http.Get(ts.URL + path)
		if err != nil {
			panic(err)
		}
		start = time.Now()
