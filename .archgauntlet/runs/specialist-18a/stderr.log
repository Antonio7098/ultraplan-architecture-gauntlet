package app

import (
	"context"
	"fmt"
	"sort"
	"testing"
	"time"

	"github.com/Antonio7098/ultraplan-go/internal/platform/runtime"
	"github.com/Antonio7098/ultraplan-go/internal/runcontrol"
)

// Reproduce the c455510 scenario: an opencode tool_use event with nested
// part/state maps, mapped by runtime.Adapter.mapEvent (promote), then drafted
// by runtimeEventDraft, then durably appended via runcontrol.Append.
func TestScratchDurableEventFieldSurvival(t *testing.T) {
	ctx := context.Background()
	repository, err := runcontrol.OpenSQLite(ctx, t.TempDir(), runcontrol.SQLiteOptions{})
	if err != nil {
		t.Fatal(err)
	}
	defer repository.Close()
	snapshot, err := repository.Accept(ctx, runcontrol.Acceptance{Target: runcontrol.Target{Kind: "study", Operation: "execute"}})
	if err != nil {
		t.Fatal(err)
	}
	owner := runcontrol.Owner{ID: "owner", Process: runcontrol.ProcessIdentity{PID: 1}}
	attempt, _, err := repository.Claim(ctx, runcontrol.Claim{RunID: snapshot.RunID, Owner: owner, Lease: 15 * time.Second})
	if err != nil {
		t.Fatal(err)
	}
	fence := runcontrol.Fence{RunID: snapshot.RunID, AttemptID: attempt.ID, OwnerID: owner.ID, FencingGeneration: attempt.FencingGeneration}

	req := runtime.Request{Metadata: map[string]string{"stage": "implement", "task": "task-1"}}
	nested := map[string]any{
		"type": "tool_use",
		"part": map[string]any{
			"type": "tool",
			"state": map[string]any{
				"status": "running",
				"title":  "Read internal/app/run_control.go",
				"input":  map[string]any{"file_path": "/home/user/internal/app/run_control.go"},
				"metadata": map[string]any{"tool": "read", "action": "open"},
			},
			"tool": "read",
		},
		"text": "assistant reasoning delta about the plan",
	}
	draft := runtimeEventDraft(req, runtime.Event{ID: "evt-1", RunID: "r-1", SessionID: "s-1", Type: "message.part.updated", Kind: "tool", Payload: nested})
	t.Logf("draft payload keys: %v", keysOf(draft.Payload))
	t.Logf("draft omission: %+v", draft.Omission)

	event, _, err := repository.Append(ctx, fence, draft)
	if err != nil {
		t.Fatal(err)
	}
	t.Logf("stored event type=%s payload=%v", event.Type, event.Payload)
	t.Logf("stored omission: %+v", event.Omission)

	events, err := repository.Events(ctx, snapshot.RunID, 0, 10)
	if err != nil {
		t.Fatal(err)
	}
	for _, e := range events {
		fmt.Printf("seq=%d type=%s payload_keys=%v omission=%+v\n", e.Sequence, e.Type, keysOf(e.Payload), e.Omission)
	}
}

func keysOf(m map[string]string) []string {
	out := make([]string, 0, len(m))
	for k := range m {
		out = append(out, k)
	}
	sort.Strings(out)
	return out
}
EOF
