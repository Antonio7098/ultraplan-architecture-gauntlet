package main

import (
	"context"
	"fmt"

	rc "github.com/Antonio7098/ultraplan-go/internal/runcontrol"
)

func main() {
	ctx := context.Background()
	repo, err := rc.OpenSQLite(ctx, "/tmp/opencode/fencecheck/ws", rc.SQLiteOptions{})
	if err != nil {
		panic(err)
	}
	defer repo.Close()
	snap, err := repo.Accept(ctx, rc.Acceptance{Target: rc.Target{Kind: "probe", Operation: "drift"}})
	if err != nil {
		panic(err)
	}
	att, _, err := repo.Claim(ctx, rc.Claim{RunID: snap.RunID, Owner: rc.Owner{ID: "probe-owner", Process: rc.ProcessIdentity{PID: 1}}, Lease: rc.OwnerLeaseDuration})
	if err != nil {
		panic(err)
	}
	fence := rc.Fence{RunID: snap.RunID, AttemptID: att.ID, OwnerID: "probe-owner", FencingGeneration: att.FencingGeneration}
	draft := rc.EventDraft{Type: rc.EventMessage, Payload: map[string]string{
		"runtime_event_id": "e1", "runtime_run_id": "r1", "session_id": "s1",
		"type": "message", "kind": "assistant",
		"text":    "hello from agent stream",
		"delta":   "partial text",
		"title":   "Edit file",
		"detail":  "src/foo.ts",
		"content": "{...}",
		"tool":    "edit",
	}}
	ev, _, err := repo.Append(ctx, fence, draft)
	if err != nil {
		panic(err)
	}
	fmt.Printf("committed event seq=%d type=%s\npayload=%v\nomission=%+v\n", ev.Sequence, ev.Type, ev.Payload, func() *rc.Omission {
		events, _ := repo.Events(ctx, snap.RunID, 0, 10)
		return events[0].Omission
	}())
}
EOF
