func TestDriftProbeScratch(t *testing.T) {
	if os.Getenv("SCRATCH_DRIFT") == "" {
		t.Skip("scratch")
	}
	ctx := context.Background()
	repo, err := OpenSQLite(ctx, t.TempDir(), SQLiteOptions{})
	if err != nil {
		t.Fatal(err)
	}
	defer repo.Close()
