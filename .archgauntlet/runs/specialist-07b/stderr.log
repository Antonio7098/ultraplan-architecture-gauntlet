	if err != nil {
		t.Fatal(err)
	}
	att, _, err := repo.Claim(ctx, Claim{RunID: snap.RunID, Owner: Owner{ID: "probe-owner", Process: ProcessIdentity{PID: 1}}, Lease: OwnerLeaseDuration})
	if err != nil {
		t.Fatal(err)
	}
	fence := Fence{RunID: snap.RunID, AttemptID: att.ID, OwnerID: "probe-owner", FencingGeneration: att.FencingGeneration}
	draft := EventDraft{Type: EventMessage, Payload: map[string]string{
		"runtime_event_id": "e1", "runtime_run_id": "r1", "session_id": "s1",
