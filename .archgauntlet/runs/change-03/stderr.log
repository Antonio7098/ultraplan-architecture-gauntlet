	ToolCallIDPayloadKey    = "tool_call_id"
	ToolNamePayloadKey      = "tool_name"
	ToolStatusPayloadKey    = "tool_status"
	ToolArgumentsPayloadKey = "tool_arguments"
	ToolResultPayloadKey    = "tool_result"
	ToolErrorPayloadKey     = "tool_error"
